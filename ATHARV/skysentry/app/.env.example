# Copy to .env and fill in what you have. Anything left blank runs in demo mode.
# Never commit .env (it is in .gitignore).

PORT=8080
AIRPORT_NAME=Princeton Airport

# Tiger Data (PostgreSQL + TimescaleDB) connection string
TIGER_DATABASE_URL=

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=skysentry

# Gemini key from Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs text-to-speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Solana devnet keypair as a JSON array of 64 numbers (devnet only; free test tokens)
SOLANA_SECRET_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com

# Seconds between repeat incidents for the same camera and type, in ms
INCIDENT_COOLDOWN_MS=30000
