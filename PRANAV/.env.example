# Copy to .env for local development: cp .env.example .env
# On DigitalOcean, set these in the app's Settings → Environment Variables (as encrypted secrets).

# Secret cameras must send to publish events (required in production).
CAMERA_API_KEY=change-me-camera-key
# Optional secret tower dashboards must send to receive events. Leave empty to allow any dashboard.
TOWER_API_KEY=
# Allowed origins for cross-origin Socket.IO clients, comma-separated, or *.
CORS_ORIGIN=*
# MongoDB Atlas connection string: stores incident reports, every detection (hourly chart, kept 8 days), airports.
# Without it, the last 24 h of detections are kept in memory only.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0
# Bird judge: gemini (default), local (a model on your own computer) or off. For local, run e.g. Ollama
# ("ollama pull qwen2.5vl:7b") and point LOCAL_JUDGE_URL at its OpenAI-compatible endpoint.
BIRD_JUDGE=gemini
LOCAL_JUDGE_URL=http://localhost:11434/v1
LOCAL_JUDGE_MODEL=qwen2.5vl:7b
# on = keep the crop with each confident bird verdict (for building a local-model training set; uses storage)
SAVE_JUDGE_IMAGES=off
# Clerk sign-in (dashboard.clerk.com → API keys). When set, camera and dashboard pages require an account.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Airport join codes people enter when they sign up: AIRPORT=code, comma-separated. Use long, unguessable codes.
AIRPORT_CODES=KPCT=change-me-pct-code,KTTN=change-me-ttn-code
# AI step (all optional; each falls back to a demo stand-in when blank).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BACKUP_MODEL=gemini-3.5-flash-lite
# Chatbots: tower copilot (/api/chat) and website guide (/api/guide). Without a key the copilot uses Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_GUIDE_MODEL=gpt-5-nano
# Solana devnet keypair as a JSON array of 64 numbers (free test tokens, no real money).
SOLANA_SECRET_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com
AIRPORT_NAME=Princeton Airport
# Minimum ms between AI reports for the same camera and threat type (escalations always run).
AI_COOLDOWN_MS=30000
# Public address used in sitemap.xml / robots.txt (optional; defaults to the domain the request came in on).
SITE_URL=
