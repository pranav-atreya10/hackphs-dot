# Copy to .env for local development: cp .env.example .env
# On DigitalOcean, set these in the app's Settings → Environment Variables (as encrypted secrets).

# Secret cameras must send to publish events (required in production).
CAMERA_API_KEY=change-me-camera-key
# Optional secret tower dashboards must send to receive events. Leave empty to allow any dashboard.
TOWER_API_KEY=
# Allowed origins for cross-origin Socket.IO clients, comma-separated, or *.
CORS_ORIGIN=*
# Tiger Data (TimescaleDB) connection string. Events are stored in the detections table when set.
DATABASE_URL=postgres://tsdbadmin:password@host.tsdb.cloud.timescale.com:port/tsdb?sslmode=require
# MongoDB Atlas connection string. Yellow/red events are stored as incident reports when set.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0
# Clerk sign-in (dashboard.clerk.com → API keys). When set, camera and dashboard pages require an account.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Airport join codes people enter when they sign up: AIRPORT=code, comma-separated. Use long, unguessable codes.
AIRPORT_CODES=KPCT=change-me-pct-code,KTTN=change-me-ttn-code
# AI step (all optional; each falls back to a demo stand-in when blank).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Solana devnet keypair as a JSON array of 64 numbers (free test tokens, no real money).
SOLANA_SECRET_KEY=
AIRPORT_NAME=Princeton Airport
# Minimum ms between AI reports for the same camera and threat type (escalations always run).
AI_COOLDOWN_MS=30000
