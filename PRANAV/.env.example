# Copy to .env for local development: cp .env.example .env
# On DigitalOcean, set these in the app's Settings → Environment Variables (as encrypted secrets).

# Secret cameras must send to publish events (required in production).
CAMERA_API_KEY=change-me-camera-key
# Optional secret tower dashboards must send to receive events. Leave empty to allow any dashboard.
TOWER_API_KEY=
# Allowed origins for cross-origin Socket.IO clients, comma-separated, or *.
CORS_ORIGIN=*
# Tiger Data (TimescaleDB) connection string. Events are stored in the detections table when set.
DATABASE_URL=postgres://tsdbadmin:password@host.tsdb.cloud.timescale.com:port/tsdb?sslmode=require
# MongoDB Atlas connection string. Yellow/red events are stored as incident reports when set.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?appName=Cluster0
